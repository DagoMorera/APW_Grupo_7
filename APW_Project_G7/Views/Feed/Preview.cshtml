@model IEnumerable<APW.Mvc.Models.FeedEntryViewModel>
@{
    ViewData["Title"] = "Feed";
    var feedUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/feed.xml";
}

<h2>Tu Feed en RSS</h2>
<p class="text-muted">
    Esta es la misma informacion que se publica en <code>/feed.xml</code>, mostrada de forma visual.
    Copia la URL de abajo en tu lector de RSS (Feedly, Inoreader, etc.) para suscribirte.
</p>

<div class="input-group mb-4" style="max-width: 560px;">
    <input type="text" class="form-control" value="@feedUrl" id="apwFeedUrlInput" readonly
           onclick="this.select();" />
    <button class="btn btn-apw-outline" type="button" onclick="navigator.clipboard.writeText(document.getElementById('apwFeedUrlInput').value)">
        Copiar
    </button>
    <a href="/feed.xml" target="_blank" class="btn btn-apw-outline">Ver XML</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Todavia no hay items guardados en el feed. <a asp-controller="Explore" asp-action="Index">Explora tus fuentes</a> para agregar los primeros.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var entry in Model)
        {
            <div class="col">
                <div class="card h-100 apw-feed-card">
                    @if (!string.IsNullOrWhiteSpace(entry.ImageUrl))
                    {
                        <img src="@entry.ImageUrl" class="card-img-top" alt="@entry.Title"
                             style="height: 180px; object-fit: cover;"
                             onerror="this.style.display='none';" />
                    }
                    <div class="card-body d-flex flex-column">
                        <span class="badge apw-badge-source align-self-start mb-2">@entry.SourceName</span>

                        <h5 class="card-title">@entry.Title</h5>

                        <p class="card-text small"
                               style="display:-webkit-box; -webkit-line-clamp:4; -webkit-box-orient:vertical; overflow:hidden;">
                            @entry.Description
                        </p>

                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <small class="text-muted">@entry.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</small>
                                <a href="@entry.Link" target="_blank" rel="noopener" class="btn btn-sm btn-apw-outline">Ver original &#8599;</a>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(entry.RawJson))
                            {
                                <details class="apw-json-details">
                                    <summary>Ver JSON completo</summary>
                                    <pre class="apw-json-block">@entry.RawJson</pre>
                                </details>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <style>
        .apw-feed-card {
            background-color: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .apw-badge-source {
            background-color: rgba(45, 212, 191, 0.15);
            color: #2dd4bf;
            font-weight: 500;
        }

        .apw-json-details summary {
            cursor: pointer;
            color: #9ca3af;
            font-size: 0.85rem;
        }

        .apw-json-block {
            background-color: #000;
            color: #6ee7b7;
            font-size: 0.75rem;
            padding: 0.75rem;
            margin-top: 0.5rem;
            max-height: 220px;
            overflow: auto;
            white-space: pre-wrap;
            word-break: break-word;
            border-radius: 4px;
        }
    </style>
}
