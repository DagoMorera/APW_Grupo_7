@model List<APW.Mvc.Models.FeedEntryViewModel>
@{
    ViewData["Title"] = "Mi Feed";
    var hasSubscriptions = ViewBag.HasSubscriptions as bool? ?? false;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="mb-8 border-b-4 border-yellow-400 pb-4" data-aos="fade-up">
    <span class="apw-badge mb-2 text-yellow-300">&#11088; Feed Personal</span>
    <h1 class="font-display text-3xl md:text-4xl font-semibold mt-2">Solo tus fuentes favoritas</h1>
    <p class="text-apwmuted mt-2">El contenido de las fuentes a las que estas suscrito.</p>
</div>

@if (!hasSubscriptions)
{
    <div class="apw-card p-6 text-center" data-aos="fade-up">
        <p>Todavia no estas suscrito a ninguna fuente.</p>
        <a asp-controller="Explore" asp-action="Index" class="text-apwaccent hover:underline">Explora las fuentes disponibles</a> y suscribete a las que te interesen.
    </div>
}
else if (!Model.Any())
{
    <div class="apw-card p-6 text-center" data-aos="fade-up">
        Estas suscrito, pero tus fuentes todavia no tienen items guardados.
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var entry in Model)
        {
            <div class="apw-card flex flex-col overflow-hidden" data-aos="fade-up">
                @if (!string.IsNullOrWhiteSpace(entry.ImageUrl))
                {
                    <img src="@entry.ImageUrl" alt="@entry.Title" class="w-full h-44 object-cover" onerror="this.style.display='none';" />
                }
                <div class="p-4 flex flex-col flex-1">
                    <span class="apw-badge self-start mb-2">@entry.SourceName</span>
                    <h5 class="font-display text-lg mb-2">@entry.Title</h5>
                    <p class="text-sm text-apwmuted mb-3 line-clamp-4">@entry.Description</p>
                    <div class="mt-auto">
                        <div class="flex justify-between items-center mb-2">
                            <small class="text-apwmuted">@entry.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</small>
                            <a href="@entry.Link" target="_blank" rel="noopener" class="apw-btn-outline text-xs">Ver original &#8599;</a>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(entry.RawJson))
                        {
                            <details class="text-xs mb-2">
                                <summary class="cursor-pointer text-apwmuted">Ver JSON completo</summary>
                                <pre class="bg-black text-green-300 text-xs p-3 mt-2 max-h-52 overflow-auto rounded whitespace-pre-wrap break-words">@entry.RawJson</pre>
                            </details>
                        }
                        <form asp-controller="Subscription" asp-action="Toggle" method="post">
                            <input type="hidden" name="sourceId" value="@entry.SourceId" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="apw-btn-danger w-full">Desuscribirse de @entry.SourceName</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}