@model IEnumerable<FeedItemViewModel>
@{
    ViewData["Title"] = "Inicio";
}

<div class="apw-hero mb-4">
    <h1 class="display-6 fw-bold">Tu Feed de Noticias</h1>
    <p class="text-muted">Los items guardados de todas tus fuentes, en un solo lugar</p>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        Todavia no hay items guardados.
        <a asp-controller="Explore" asp-action="Index" class="alert-link">Explora tus fuentes</a> para agregar los primeros.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 apw-feed-card">
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top apw-feed-img" alt="@item.Title" />
                    }
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-secondary align-self-start mb-2">@item.SourceName</span>
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text apw-feed-description">@item.Description</p>
                        <div class="mt-auto pt-2">
                            <small class="text-muted d-block mb-2">@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</small>
                            <div class="d-flex gap-2">
                                @if (!string.IsNullOrWhiteSpace(item.Link))
                                {
                                    <a href="@item.Link" target="_blank" class="btn btn-sm btn-outline-secondary flex-fill">Ver mas</a>
                                }
                                <a asp-action="DownloadItem" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary flex-fill">Descargar</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}