@model List<APW.Mvc.Models.FeedEntryViewModel>
@{
    ViewData["Title"] = "Inicio";
    var subscribedIds = ViewBag.SubscribedSourceIds as HashSet<int> ?? new HashSet<int>();
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="mb-8 border-b-4 border-apwaccent pb-4" data-aos="fade-up">
    <span class="apw-badge mb-2">&#127760; Feed Global</span>
    <h1 class="font-display text-3xl md:text-4xl font-semibold mt-2">Lo que la comunidad esta guardando</h1>
    <p class="text-apwmuted mt-2">
        Todos los items guardados, de todas las fuentes. &#191;Quieres ver solo lo tuyo?
        <a asp-controller="Feed" asp-action="MyFeed" class="text-apwaccent hover:underline">Ve a Mi Feed</a>.
    </p>
</div>

@if (!Model.Any())
{
    <div class="apw-card p-6 text-center" data-aos="fade-up">
        <p>Todavia no hay items guardados.</p>
        <a asp-controller="Explore" asp-action="Index" class="text-apwaccent hover:underline">Explora tus fuentes</a> para agregar los primeros.
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var entry in Model)
        {
            var isSubscribed = subscribedIds.Contains(entry.SourceId);

            <div class="apw-card flex flex-col overflow-hidden" data-aos="fade-up">
                @if (!string.IsNullOrWhiteSpace(entry.ImageUrl))
                {
                    <img src="@entry.ImageUrl" alt="@entry.Title" class="w-full h-44 object-cover" onerror="this.style.display='none';" />
                }
                <div class="p-4 flex flex-col flex-1">
                    <div class="flex justify-between items-start gap-2 mb-2">
                        <span class="apw-badge">@entry.SourceName</span>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <form asp-controller="Subscription" asp-action="Toggle" method="post">
                                <input type="hidden" name="sourceId" value="@entry.SourceId" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                @if (isSubscribed)
                                {
                                    <button type="submit" class="apw-btn-danger text-xs" title="Desuscribirse de @entry.SourceName">&#10003; Suscrito</button>
                                }
                                else
                                {
                                    <button type="submit" class="apw-btn-outline text-xs" title="Suscribirse a @entry.SourceName">+ Suscribirse</button>
                                }
                            </form>
                        }
                    </div>
                    <h5 class="font-display text-lg mb-2">@entry.Title</h5>
                    <p class="text-sm text-apwmuted mb-3 line-clamp-4">@entry.Description</p>
                    <div class="mt-auto">
                        <small class="text-apwmuted block mb-2">@entry.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</small>
                        <div class="flex gap-2 mb-2">
                            <a href="@entry.Link" target="_blank" rel="noopener" class="apw-btn-outline flex-1">Ver mas</a>
                            <a asp-action="DownloadItem" asp-route-id="@entry.Id" class="apw-btn-outline flex-1">Descargar</a>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(entry.RawJson))
                        {
                            <details class="text-xs">
                                <summary class="cursor-pointer text-apwmuted">Ver JSON completo</summary>
                                <pre class="bg-black text-green-300 text-xs p-3 mt-2 max-h-52 overflow-auto rounded whitespace-pre-wrap break-words">@entry.RawJson</pre>
                            </details>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}