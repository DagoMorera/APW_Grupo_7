@model IEnumerable<SourceViewModel>
@{
    ViewData["Title"] = "Explorar Fuentes";
}

<div class="apw-hero mb-4">
    <h1 class="display-6">Explorar Fuentes</h1>
    <p class="text-muted">Descubre el contenido disponible en cada fuente configurada</p>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay fuentes configuradas todavia.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var source in Model)
        {
            <div class="col">
                <div class="apw-explore-card">
                    <div class="apw-explore-seal">&#9670;</div>
                    <h5 class="apw-explore-title">@source.Name</h5>
                    <span class="apw-explore-type">@source.ComponentType</span>
                    <p class="apw-explore-desc">@source.Description</p>
                    <a asp-action="Details" asp-route-id="@source.Id" class="btn btn-apw-primary w-100 mt-auto">Explorar</a>
                </div>
            </div>
        }
    </div>
}