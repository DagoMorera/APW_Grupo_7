@model IEnumerable<ParsedSourceItemViewModel>
@{
    ViewData["Title"] = $"Explorar - {ViewBag.SourceName}";
    var subscribedIds = ViewBag.SubscribedSourceIds as HashSet<int> ?? new HashSet<int>();
    var sourceId = ViewBag.SourceId as int? ?? 0;
    var isSubscribed = subscribedIds.Contains(sourceId);
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="flex justify-between items-center flex-wrap gap-3 mb-6" data-aos="fade-up">
    <div>
        <h2 class="font-display text-2xl">@ViewBag.SourceName</h2>
        <p class="text-apwmuted">Items en vivo, aun no guardados</p>
    </div>
    <div class="flex items-center gap-2">
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <form asp-controller="Subscription" asp-action="Toggle" method="post">
                <input type="hidden" name="sourceId" value="@sourceId" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                @if (isSubscribed)
                {
                    <button type="submit" class="apw-btn-danger">Desuscribirse</button>
                }
                else
                {
                    <button type="submit" class="apw-btn-primary">Suscribirse</button>
                }
            </form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="apw-btn-primary">Suscribirse</a>
        }
        <a asp-action="Index" class="apw-btn-outline">&larr; Volver a Fuentes</a>
    </div>
</div>

@if (TempData["Mensaje"] is not null)
{
    <div class="bg-green-900/30 border border-apwaccent text-apwaccent rounded-lg p-3 mb-4">@TempData["Mensaje"]</div>
}

@if (!Model.Any())
{
    <div class="apw-card p-6 text-center">No se encontraron items en esta fuente.</div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var item in Model)
        {
            <div class="apw-card flex flex-col overflow-hidden" data-aos="fade-up">
                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" alt="@item.Title" class="w-full h-44 object-cover" />
                }
                <div class="p-4 flex flex-col flex-1">
                    <h5 class="font-display text-lg mb-2">@item.Title</h5>
                    <p class="text-sm text-apwmuted mb-3 line-clamp-4 flex-1">@item.Description</p>

                    @if (User.IsInRole("Admin"))
                    {
                        <form asp-action="Save" method="post" class="mt-auto">
                            <input type="hidden" name="sourceId" value="@ViewBag.SourceId" />
                            <input type="hidden" name="item.Title" value="@item.Title" />
                            <input type="hidden" name="item.Description" value="@item.Description" />
                            <input type="hidden" name="item.Link" value="@item.Link" />
                            <input type="hidden" name="item.ImageUrl" value="@item.ImageUrl" />
                            <input type="hidden" name="item.RawJson" value="@item.RawJson" />
                            <button type="submit" class="apw-btn-primary w-full">Guardar</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}