@model IEnumerable<ParsedSourceItemViewModel>
@{
    ViewData["Title"] = $"Explorar - {ViewBag.SourceName}";
    var subscribedIds = ViewBag.SubscribedSourceIds as HashSet<int> ?? new HashSet<int>();
    var sourceId = ViewBag.SourceId as int? ?? 0;
    var isSubscribed = subscribedIds.Contains(sourceId);
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>@ViewBag.SourceName</h2>
        <p class="text-muted mb-0">Items en vivo, aun no guardados</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <form asp-controller="Subscription" asp-action="Toggle" method="post" class="d-inline">
                <input type="hidden" name="sourceId" value="@sourceId" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                @if (isSubscribed)
                {
                    <button type="submit" class="btn btn-outline-danger">Desuscribirse</button>
                }
                else
                {
                    <button type="submit" class="btn btn-success">Suscribirse</button>
                }
            </form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="btn btn-success">Suscribirse</a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">&larr; Volver a Fuentes</a>
    </div>
</div>

@if (TempData["Mensaje"] is not null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-warning">No se encontraron items en esta fuente.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 apw-feed-card">
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top apw-feed-img" alt="@item.Title" />
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text apw-feed-description">@item.Description</p>

                        @if (User.IsInRole("Admin"))
                        {
                            <form asp-action="Save" method="post" class="mt-auto pt-2">
                                <input type="hidden" name="sourceId" value="@ViewBag.SourceId" />
                                <input type="hidden" name="item.Title" value="@item.Title" />
                                <input type="hidden" name="item.Description" value="@item.Description" />
                                <input type="hidden" name="item.Link" value="@item.Link" />
                                <input type="hidden" name="item.ImageUrl" value="@item.ImageUrl" />
                                <input type="hidden" name="item.RawJson" value="@item.RawJson" />
                                <button type="submit" class="btn btn-sm btn-apw-primary w-100">Guardar</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
