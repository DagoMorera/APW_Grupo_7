@{
    ViewData["Title"] = "Importar Item";
}

<div class="apw-hero mb-4">
    <h1 class="display-6 fw-bold">Importar Item</h1>
    <p class="text-muted">Sube un archivo JSON exportado (de esta app o de otro grupo) para cargarlo en la base de datos</p>
</div>

@if (TempData["Mensaje"] is not null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<form asp-action="Index" method="post" enctype="multipart/form-data" class="col-md-6">
    <div class="mb-3">
        <label class="form-label">Archivo JSON</label>
        <input type="file" name="jsonFile" accept=".json" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-apw-primary">Importar</button>
</form>