@model IEnumerable<SourceViewModel>
@{
    ViewData["Title"] = "Fuentes";
}

<div class="flex justify-between items-center flex-wrap gap-3 mb-6" data-aos="fade-up">
    <div>
        <h2 class="font-display text-2xl">Registro de Fuentes</h2>
        <p class="text-apwmuted">Las fuentes configuradas para la ingesta de contenido</p>
    </div>
    <a asp-action="Create" class="apw-btn-primary">+ Agregar Fuente</a>
</div>

@if (!Model.Any())
{
    <div class="apw-card p-6 text-center">Aun no hay fuentes registradas.</div>
}
else
{
    <div class="flex flex-col gap-3">
        @foreach (var source in Model)
        {
            <div class="apw-card border-l-4 border-l-apwaccent flex items-center gap-4 p-4" data-aos="fade-right">
                <div class="flex-1 min-w-0">
                    <div class="font-display text-base">
                        @source.Name
                        @if (source.RequiresSecret)
                        {
                            <span class="text-xs ml-1" title="Requiere Secret">&#128274;</span>
                        }
                    </div>
                    <div class="text-sm text-apwmuted truncate">@source.Url</div>
                    @if (!string.IsNullOrWhiteSpace(source.Description))
                    {
                        <div class="text-sm text-apwmuted italic">@source.Description</div>
                    }
                </div>
                <span class="apw-badge">@source.ComponentType</span>
                <div class="flex gap-2 flex-shrink-0">
                    <a asp-action="Edit" asp-route-id="@source.Id" class="apw-btn-outline">Editar</a>
                    <a asp-action="Delete" asp-route-id="@source.Id" class="apw-btn-danger">Eliminar</a>
                </div>
            </div>
        }
    </div>
}