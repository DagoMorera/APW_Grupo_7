@model SourceViewModel
@{
    ViewData["Title"] = "Eliminar Fuente";
}

<h2 class="font-display text-2xl mb-6" data-aos="fade-up">Eliminar Fuente</h2>

<div class="bg-yellow-900/30 border border-yellow-600 text-yellow-300 rounded-lg p-3 mb-4 max-w-xl" data-aos="fade-up">
    &#191;Estas seguro que deseas eliminar esta fuente?
</div>

<div class="apw-card p-6 max-w-xl mb-4" data-aos="fade-up">
    <dl class="grid grid-cols-3 gap-2 text-sm">
        <dt class="text-apwmuted col-span-1">Nombre</dt>
        <dd class="col-span-2">@Model.Name</dd>
        <dt class="text-apwmuted col-span-1">Url</dt>
        <dd class="col-span-2 truncate">@Model.Url</dd>
        <dt class="text-apwmuted col-span-1">Tipo</dt>
        <dd class="col-span-2">@Model.ComponentType</dd>
    </dl>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="flex gap-2">
    <button type="submit" class="apw-btn-danger">Eliminar</button>
    <a asp-action="Index" class="apw-btn-outline">Cancelar</a>
</form>