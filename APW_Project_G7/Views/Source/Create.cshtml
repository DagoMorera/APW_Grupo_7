@model SourceViewModel
@{
    ViewData["Title"] = "Agregar Fuente";
}

<h2 class="font-display text-2xl mb-6" data-aos="fade-up">Agregar Fuente</h2>

<form asp-action="Create" method="post" class="apw-card p-6 max-w-xl" data-aos="fade-up">
    <div asp-validation-summary="ModelOnly" class="text-red-400 mb-3"></div>

    <div class="mb-4">
        <label asp-for="Name" class="apw-label">Nombre</label>
        <input asp-for="Name" class="apw-input" />
    </div>
    <div class="mb-4">
        <label asp-for="Url" class="apw-label">Url</label>
        <input asp-for="Url" class="apw-input" />
    </div>
    <div class="mb-4">
        <label asp-for="Description" class="apw-label">Descripcion</label>
        <textarea asp-for="Description" class="apw-input"></textarea>
    </div>
    <div class="mb-4">
        <label asp-for="ComponentType" class="apw-label">Tipo (widget, api, feed)</label>
        <input asp-for="ComponentType" class="apw-input" />
    </div>
    <div class="mb-6 flex items-center gap-2">
        <input asp-for="RequiresSecret" class="w-4 h-4" />
        <label asp-for="RequiresSecret" class="apw-label mb-0">Requiere Secret</label>
    </div>

    <div class="flex gap-2">
        <button type="submit" class="apw-btn-primary">Guardar</button>
        <a asp-action="Index" class="apw-btn-outline">Cancelar</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}