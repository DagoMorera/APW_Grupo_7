@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesion";
}

<div class="flex justify-center mt-10">
    <div class="apw-card p-8 w-full max-w-md" data-aos="zoom-in">
        <h3 class="font-display text-2xl text-center mb-6">Iniciar Sesion</h3>

        <form asp-controller="Account" asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-red-400 mb-3"></div>

            <div class="mb-4">
                <label asp-for="Username" class="apw-label">Usuario</label>
                <input asp-for="Username" class="apw-input" autofocus />
                <span asp-validation-for="Username" class="text-red-400 text-sm"></span>
            </div>

            <div class="mb-6">
                <label asp-for="Password" class="apw-label">Password</label>
                <input asp-for="Password" class="apw-input" />
                <span asp-validation-for="Password" class="text-red-400 text-sm"></span>
            </div>

            <button type="submit" class="apw-btn-primary w-full">Ingresar</button>
        </form>

        <p class="text-center mt-4">
            &#191;No tienes cuenta? <a asp-controller="Account" asp-action="Register" class="text-apwaccent hover:underline">Registrate aqui</a>
        </p>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}